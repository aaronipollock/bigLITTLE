# Copy this file to .env and fill in your own values.

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL connection string: postgresql://USER@HOST:PORT/DATABASE
DATABASE_URL=postgresql://localhost:5432/biglittle_dev

# Auth — use a long, random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRES_IN=7d
